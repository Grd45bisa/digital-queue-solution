// Get teller's current customer
router.get('/teller/:tellerId/current', async (req, res) => {
  try {
    const { tellerId } = req.params;
    const today = getTodayDate();

    const { data: currentCustomer, error } = await supabase
      .from('customers')
      .select('*')
      .eq('date', today)
      .eq('teller_id', tellerId)
      .eq('status', 'processing')
      .single();

    if (error && error.code === 'PGRST116') {
      return res.json({
        success: true,
        data: { currentCustomer: null }
      });
    }

    if (error) throw error;

    res.json({
      success: true,
      data: { currentCustomer }
    });

  } catch (error) {
    console.error('Error fetching current customer:', error);
    res.status(500).json({
      success: false,
      message: 'Internal server error'
    });
  }
});

// Get next customers
router.get('/teller/next-customers', async (req, res) => {
  try {
    const { limit = 5 } = req.query;
    const today = getTodayDate();

    const { data: nextCustomers, error } = await supabase
      .from('customers')
      .select('*')
      .eq('date', today)
      .eq('status', 'waiting')
      .eq('is_expired', false)
      .order('queue_order', { ascending: true })
      .limit(parseInt(limit));

    if (error) throw error;

    const { count } = await supabase
      .from('customers')
      .select('*', { count: 'exact', head: true })
      .eq('date', today)
      .eq('status', 'waiting')
      .eq('is_expired', false);

    res.json({
      success: true,
      data: {
        nextCustomers: nextCustomers || [],
        totalWaiting: count || 0
      }
    });

  } catch (error) {
    console.error('Error fetching next customers:', error);
    res.status(500).json({
      success: false,
      message: 'Internal server error'
    });
  }
});

// Get stats
router.get('/stats', async (req, res) => {
  try {
    const today = getTodayDate();

    const { data: customers, error } = await supabase
      .from('customers')
      .select('status')
      .eq('date', today);

    if (error) throw error;

    const stats = {
      waiting: 0,
      processing: 0,
      completed: 0
    };

    customers.forEach(c => {
      stats[c.status] = (stats[c.status] || 0) + 1;
    });

    res.json({
      success: true,
      data: {
        total: customers.length,
        stats
      }
    });

  } catch (error) {
    console.error('Error fetching stats:', error);
    res.status(500).json({
      success: false,
      message: 'Internal server error'
    });
  }
});

// Reset counter
router.post('/reset-counter', async (req, res) => {
  try {
    const today = getTodayDate();

    const { data: counter, error: fetchError } = await supabase
      .from('queue_counters')
      .select('*')
      .eq('date', today)
      .single();

    if (fetchError && fetchError.code !== 'PGRST116') throw fetchError;

    if (counter) {
      // Update existing
      const { error: updateError } = await supabase
        .from('queue_counters')
        .update({
          counter: 0,
          last_reset: new Date().toISOString()
        })
        .eq('date', today);

      if (updateError) throw updateError;
    } else {
      // Create new
      const { error: insertError } = await supabase
        .from('queue_counters')
        .insert({
          date: today,
          counter: 0,
          last_reset: new Date().toISOString()
        });

      if (insertError) throw insertError;
    }

    res.json({
      success: true,
      data: {
        message: 'Queue counter reset successfully'
      }
    });

  } catch (error) {
    console.error('Error resetting counter:', error);
    res.status(500).json({
      success: false,
      message: 'Internal server error'
    });
  }
});

module.exports = router;